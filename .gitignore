# ============================================================
# .gitignore raíz del proyecto SIGC-UNT
# ============================================================

# Dependencias
**/node_modules/
**/.npm/

# Build outputs
**/dist/
**/.next/
**/build/
**/out/

# Variables de entorno (NUNCA al repositorio)
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Prisma generado
**/generated/
**/.prisma/

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*

# Coverage
**/coverage/
**/.nyc_output/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.iml

# Docker
**/docker-compose.override.yml

# Certificados SSL (se generan fuera del repo)
nginx/ssl/

# Uploads temporales
**/uploads/temp/
