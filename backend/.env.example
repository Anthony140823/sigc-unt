# ============================================================
# SIGC-UNT Backend — Variables de Entorno
# Copiar a .env y completar con valores reales
# ============================================================

# Aplicación
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3100

# Base de Datos PostgreSQL
DATABASE_URL="postgresql://sigc_user:sigc_password123@localhost:5432/sigc_unt_db?schema=sigc_unt"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_TTL=3600

# JWT
JWT_SECRET=cambia_este_secreto_super_seguro_256_bits_minimo
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia_este_refresh_secreto_diferente_al_anterior
JWT_REFRESH_EXPIRES_IN=7d

# MinIO (Almacenamiento de Archivos)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sigcadmin
MINIO_SECRET_KEY=sigc_minio_password
MINIO_BUCKET_DOCUMENTOS=sigc-documentos
MINIO_BUCKET_EVIDENCIAS=sigc-evidencias
MINIO_BUCKET_REPORTES=sigc-reportes

# Email (SMTP)
SMTP_HOST=smtp.unitru.edu.pe
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=calidad@unitru.edu.pe
SMTP_PASS=email_password
SMTP_FROM="SIGC-UNT <calidad@unitru.edu.pe>"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Encriptación datos sensibles
ENCRYPTION_KEY=clave_encriptacion_32_bytes_hex_aqui
