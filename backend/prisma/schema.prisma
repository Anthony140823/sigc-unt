  opciones_seleccionadas  Json?
  creado_en               DateTime  @default(now()) @db.Timestamptz

  @@unique([participacion_id, pregunta_id])

  participaciones_encuesta participaciones_encuesta @relation(fields: [participacion_id], references: [id], onDelete: Cascade)
  preguntas_encuesta       preguntas_encuesta       @relation(fields: [pregunta_id], references: [id])
}

// ══════════════════════════════════════════════════════════════
// LOGS Y AUDITORÍA
// ══════════════════════════════════════════════════════════════

model log_auditoria_sistema {
  id               BigInt    @id @default(autoincrement())
  usuario_id       String?   @db.Uuid
  accion           String    @db.VarChar(20)
  entidad          String    @db.VarChar(50)
  entidad_id       String?   @db.Text
  datos_anteriores Json?
  datos_nuevos     Json?
  ip_origen        String?
  user_agent       String?   @db.Text
  resultado        String    @default("EXITO") @db.VarChar(10)
  detalle_error    String?   @db.Text
  creado_en        DateTime  @default(now()) @db.Timestamptz
}

model log_sesiones {
  id               BigInt    @id @default(autoincrement())
  usuario_id       String    @db.Uuid
  tipo_evento      String    @db.VarChar(20)
  ip_origen        String?
  user_agent       String?   @db.Text
  duracion_minutos Int?
  creado_en        DateTime  @default(now()) @db.Timestamptz

  usuarios         usuarios  @relation(fields: [usuario_id], references: [id])
}

model notificaciones {
  id            BigInt    @id @default(autoincrement())
  usuario_id    String    @db.Uuid
  tipo          String    @db.VarChar(30)
  titulo        String    @db.VarChar(200)
  mensaje       String    @db.Text
  url_accion    String?   @db.VarChar(500)
  leida         Boolean   @default(false)
  fecha_lectura DateTime? @db.Timestamptz
  creado_en     DateTime  @default(now()) @db.Timestamptz

  usuarios      usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}
